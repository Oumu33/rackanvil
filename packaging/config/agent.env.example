# rackanvil-agent 配置文件（安装到 /etc/rackanvil/agent.env 后生效）
# 语法：systemd EnvironmentFile，一行一个 KEY=VALUE，改完执行
#   systemctl restart rackanvil-agent

# 管理 server 的基地址（被管节点必须能访问这个地址的 9100 端口）。
RACKANVIL_SERVER=http://127.0.0.1:9100
# 心跳（checkin）间隔：向 server 报到并领取待执行任务。
RACKANVIL_INTERVAL=30s
# 指标上报间隔：CPU/内存/磁盘/SMART 采集后上报；填 0s 关闭指标上报。
RACKANVIL_METRICS_INTERVAL=60s
# 固件升级双门控（环境侧）：设为 1 才允许本节点执行固件升级任务。
# 默认 0 = 一律拒绝（刷错固件会变砖，确认无误再开）。
RACKANVIL_ALLOW_FW_UPGRADE=0
