# rackanvil-server 配置文件（安装到 /etc/rackanvil/server.env 后生效）
# 语法：systemd EnvironmentFile，一行一个 KEY=VALUE，改完执行
#   systemctl restart rackanvil-server
# 每个变量对应 server 的一个命令行参数，默认值与代码一致（在代码中实读核对）。

# HTTP 监听地址。API、Web 控制台、PXE 引导脚本都走这一个端口。
RACKANVIL_ADDR=:9100
# 对外可达的服务基地址：写进 iPXE 引导脚本和装机配置，PXE 客户端按它回连。
# 单机试用保持 127.0.0.1；正式部署改成被管网段能访问的 IP/域名。
RACKANVIL_PUBLIC_URL=http://127.0.0.1:9100
# 数据库 DSN。二选一：
#   sqlite:/var/lib/rackanvil/rackanvil.db   （默认，零依赖，适合中小规模）
#   postgres://用户:密码@主机:5432/库名  （生产推荐，同一套迁移自动建表）
RACKANVIL_DB=sqlite:/var/lib/rackanvil/rackanvil.db
# 引导资产目录（Debian netboot 内核/initrd、preseed 模板所在树）。
RACKANVIL_ASSETS=/usr/share/rackanvil/assets
# preseed 模板目录（默认在资产目录下）。
RACKANVIL_PRESEED_DIR=/usr/share/rackanvil/assets/preseed
# 装机时下发给新机的 agent 二进制路径（/agent/download 提供下载）。
RACKANVIL_AGENT_BIN=/usr/lib/rackanvil/rackanvil-agent
# Debian 镜像源覆盖：内网/离线环境指向本地镜像（如 10.0.0.5:8080），留空用官方源。
RACKANVIL_MIRROR_HOST=
RACKANVIL_MIRROR_DIR=
# 是否启用内置 DHCP/PXE 服务（监听 UDP 67）。true/false。
# 已有 DHCP 的网络请保持 false，或用 ProxyDHCP 旁路模式（下一项）。
RACKANVIL_DHCP=false
# ProxyDHCP 旁路模式：只回 PXE 引导信息，不分配地址（不动现有 DHCP）。true/false。
RACKANVIL_DHCP_PROXY=false
# DHCP 服务器标识 IP 与地址池（仅 DHCP/ProxyDHCP 相关配置）。
RACKANVIL_DHCP_SERVER_IP=192.168.100.1
RACKANVIL_DHCP_POOL_START=192.168.100.100
RACKANVIL_DHCP_POOL_END=192.168.100.200
# 授权（自研 Ed25519 体系）：公钥文件路径与 license 文件路径，留空=开发模式不校验。
RACKANVIL_LICENSE_PUBKEY=
RACKANVIL_LICENSE_FILE=
# 记录每条 HTTP 请求（路径+状态码）到日志，排查引导链问题时开启。true/false。
RACKANVIL_LOG_REQUESTS=false
